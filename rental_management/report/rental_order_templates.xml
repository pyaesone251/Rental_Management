<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_rental_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Rental Agreement <span t-field="o.name"/></h2>
                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <div class="d-flex align-items-start">
                                    <strong>Customer :</strong>
                                    <div class="ms-3" t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'phone', 'email']}"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <p>
                                    <strong>Equipment :</strong>
                                    <span class="ms-3" t-field="o.equipment_id.name"/>
                                </p>
                                <p>
                                    <strong>Status :</strong>
                                    <span class="ms-3" t-field="o.state"/>
                                </p>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thread>
                                <tr>
                                    <th>Pickup Date</th>
                                    <th>Planned Return</th>
                                    <th>Actual Return</th>
                                    <th class="text-end" >Rental Days</th>
                                    <th class="text-end" >Daily Rate</th>
                                </tr>
                            </thread>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.date_start"/></td>
                                    <td><span t-field="o.date_end"/></td>
                                    <td><span t-field="o.date_actual_return"/></td>
                                    <td class="text-end" ><span t-field="o.rental_days"/></td>
                                    <td class="text-end" ><span t-field="o.daily_rate"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row mt-4">
                            <div class="col-6 table-sm">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Late Fee</td>
                                        <td class="text-end"><span t-field="o.late_fee"/></td>
                                    </tr>
                                    <tr class="border-top">
                                        <td><strong>Total Amount</strong></td>
                                        <td class="text-end">
                                            <strong><span t-field="o.total_amount"/></strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <p t-if="o.notes" class="mt-4">
                            <strong>Notes:</strong> <span t-field="o.notes"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>