<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rental_order_list" model="ir.ui.view">
        <field name="name">view.rental.order.list</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="date_start"/>
                <field name="date_end" />
                <field name="rental_days" optional="hide"/>
                <field name="total_amount" />
                <field name="state" widget="badge"
                        decoration-info="state == 'confirmed'"
                        decoration-success="state == 'returned'"
                        decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_rental_order_form" model="ir.ui.view">
        <field name="name">view.rental.order.form</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button name="action_pickup" string="Pick Up" type="object" class="btn-primary"/>
                    <button name="action_open_renturn_wizard" string="Return" type="object" class="btn-primary" />
                    <button name="action_cancel" string="Cancel" type="object" class="btn-primary"/>
                    <button name="action_reset" string="Rest" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,picked_up,returned,cancelled"/>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="equipment_id" />
                            <field name="daily_rate" />
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end" />
                            <field name="date_actual_return" />
                        </group>
                    </group>
                    <group>
                        <field name="rental_days"/>
                        <field name="late_fee" />
                        <field name="total_amount" />
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rental_order" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first rental order
            </p>
        </field>
    </record>
</odoo>