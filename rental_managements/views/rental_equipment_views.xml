<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CONCEPT: List (tree) view - record တွေကို table ပုံစံနဲ့ list ပြတာ -->
    <record id="view_rental_equipment_list" model="ir.ui.view">
        <field name="name">rental.equipment.list</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="code"/>
                <field name="name"/>
                <field name="daily_rate" widget="monetary" optional="show"/>
                <field name="rental_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'rented'"
                       decoration-danger="state == 'maintenance'"/>
            </list>
        </field>
    </record>

    <!-- CONCEPT: Form view - record တစ်ခုချင်းစီကို အသေးစိတ် edit လုပ်တဲ့ screen -->
    <record id="view_rental_equipment_form" model="ir.ui.view">
        <field name="name">rental.equipment.form</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_rental_order)d" type="action"
                                class="oe_stat_button" icon="fa-list">
                            <field name="rental_count" widget="statinfo" string="Rentals"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="daily_rate"/>
                        <field name="state"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Rental History">
                            <field name="rental_order_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rental_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">rental.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first piece of rental equipment
            </p>
        </field>
    </record>
</odoo>
